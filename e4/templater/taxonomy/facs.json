{
 "_sources": [
  "Ekman, P., & Friesen, W. V. (1978). Facial Action Coding System. Consulting Psychologists Press.",
  "Ekman, P., Friesen, W. V., & Hager, J. C. (2002). Facial Action Coding System: The Manual (and Investigator's Guide). Research Nexus.",
  "AU names, muscles and the AD/head/eye numbering were cross-checked on 2026-10-05 against https://en.wikipedia.org/wiki/Facial_Action_Coding_System (secondary source mirroring the 2002 manual); the FACS manual itself is commercial and was not accessed.",
  "Intensity scale A (trace) to E (maximum): Ekman, Friesen & Hager (2002). The render adverbs and the per-unit 'render' phrases and 'minCloseness' are this project's own wording, not FACS text."
 ],
 "_note": "Unit codes are FACS codes. 'render' is neutral physical prose with {poss}/{adv} placeholders; it never contains the code or the word AU. 'minCloseness': 0 wide, 1 medium/OTS, 2 medium close-up, 3 close-up/ECU; a facial unit is on offer only when the shot is at least this close. Several descriptions read clinical (AU20, AU28, AU14, AU9, AU27): see README.",
 "intensity": {
  "A": {
   "label": "trace",
   "render": null
  },
  "B": {
   "label": "slight",
   "render": [
    "slightly",
    "a fraction",
    "faintly"
   ]
  },
  "C": {
   "label": "marked",
   "render": [
    "visibly",
    "noticeably",
    "clearly"
   ]
  },
  "D": {
   "label": "severe",
   "render": [
    "sharply",
    "hard",
    "strongly"
   ]
  },
  "E": {
   "label": "maximum",
   "render": null
  }
 },
